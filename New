
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>申根國家停留天數計算機 (90/180天規則)</title>
    <style>
        :root {
            --primary: #003399; /* 歐盟藍 */
            --secondary: #FFCC00; /* 歐盟星黃 */
            --bg: #f4f6f9;
            --card-bg: #ffffff;
            --text: #333333;
            --border: #cccccc;
            --success: #28a745;
            --danger: #dc3545;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 700px;
            width: 100%;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        h1 {
            color: var(--primary);
            text-align: center;
            margin-top: 0;
            font-size: 24px;
            border-bottom: 3px solid var(--secondary);
            padding-bottom: 10px;
        }

        .notice {
            background-color: #e6f0ff;
            border-left: 4px solid var(--primary);
            padding: 12px;
            margin-bottom: 20px;
            font-size: 14px;
            border-radius: 0 4px 4px 0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        input[type="date"] {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 16px;
            box-sizing: border-box;
        }

        .section-title {
            font-size: 18px;
            color: var(--primary);
            margin: 25px 0 10px 0;
            border-bottom: 1px solid var(--border);
            padding-bottom: 5px;
        }

        .stay-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            align-items: center;
            background: #f9f9f9;
            padding: 10px;
            border-radius: 6px;
            border: 1px dashed #ddd;
        }

        .stay-row div {
            flex: 1;
        }

        .stay-row label {
            font-size: 12px;
            color: #666;
            margin-bottom: 4px;
        }

        button {
            cursor: pointer;
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: bold;
            transition: background 0.2s;
        }

        .btn-add {
            background-color: #6c757d;
            color: white;
            width: 100%;
            margin-bottom: 20px;
        }

        .btn-add:hover { background-color: #5a6268; }

        .btn-calc {
            background-color: var(--primary);
            color: white;
            width: 100%;
            font-size: 18px;
            padding: 12px;
        }

        .btn-calc:hover { background-color: #002266; }

        .btn-del {
            background-color: var(--danger);
            color: white;
            padding: 8px 12px;
            margin-top: 18px;
        }

        .btn-del:hover { background-color: #bd2130; }

        .result-box {
            margin-top: 25px;
            padding: 20px;
            border-radius: 8px;
            display: none;
        }

        .result-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .result-danger {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .result-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .result-details p {
            margin: 8px 0;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>申根國家停留天數計算機</h1>
    <div class="notice">
        <strong>💡 申根法規提醒：</strong> 在任意滾動的 180 天之內，您最多只能在申根區停留 90 天。入境與出境當天（包含非申根國中轉日）皆算作申根停留日。
    </div>

    <!-- 預計旅行計畫 -->
    <div class="section-title">本次預計行程</div>
    <div class="form-group">
        <label for="entry-date">預計進入申根國日期：</label>
        <input type="date" id="entry-date" required>
    </div>
    <div class="form-group">
        <label for="exit-date">預計離開申根國日期：</label>
        <input type="date" id="exit-date" required>
    </div>

    <!-- 過去或途中在非申根國的紀錄 -->
    <div class="section-title">
        離境紀錄（中途到非申根國，或過去180天內的非申根停留）
    </div>
    <p style="font-size: 13px; color: #666; margin-top: -5px;">
        ※ 請輸入您**不在**申根區的時間（例如前往英國、土耳其，或回國的期間）。這段時間會被扣除，不計入90天限額。
    </p>
    
    <div id="non-schengen-container">
        <!-- 動態新增的非申根國紀錄會顯示在此 -->
    </div>
    <button type="button" class="btn-add" onclick="addNonSchengenRow()">＋ 新增非申根區停留紀錄</button>

    <!-- 計算按鈕 -->
    <button type="button" class="btn-calc" onclick="calculateSchengen()">立即計算安全出入境時間</button>

    <!-- 結果顯示區域 -->
    <div id="result" class="result-box">
        <div id="result-title" class="result-title"></div>
        <div id="result-details" class="result-details"></div>
    </div>
</div>

<script>
    // 預填今天日期方便測試
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('entry-date').value = today;

    // 動態新增非申根停留紀錄的欄位
    function addNonSchengenRow() {
        const container = document.getElementById('non-schengen-container');
        const rowId = 'row-' + Date.now();
        
        const rowHtml = `
            <div class="stay-row" id="${rowId}">
                <div>
                    <label>離開申根區日期 (起)</label>
                    <input type="date" class="non-sch-start" required>
                </div>
                <div>
                    <label>返回申根區日期 (止)</label>
                    <input type="date" class="non-sch-end" required>
                </div>
                <button type="button" class="btn-del" onclick="removeRow('${rowId}')">刪除</button>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', rowHtml);
    }

    function removeRow(id) {
        document.getElementById(id).remove();
    }

    // 日期差計算（包含首尾當天）
    function getDaysBetween(start, end) {
        const s = new Date(start);
        const e = new Date(end);
        if (isNaN(s) || !isNaN(e) && e < s) return 0;
        const diffTime = Math.abs(e - s);
        return Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1; 
    }

    // 核心計算邏輯
    function calculateSchengen() {
        const entryInput = document.getElementById('entry-date').value;
        const exitInput = document.getElementById('exit-date').value;

        if (!entryInput || !exitInput) {
            alert('請填寫本次預計的進入與離開日期！');
            return;
        }

        const planEntry = new Date(entryInput);
        const planExit = new Date(exitInput);

        if (planExit < planEntry) {
            alert('離開日期不能小於進入日期！');
            return;
        }

        // 1. 建立一個物件地圖來記錄「每一天」是否在申根區
        // 為了計算精準，我們涵蓋計劃離境日前推200天到計畫離境日
        const isSchengenMap = {};
        
        // 先假設這段期間天天都在申根區
        let tempDate = new Date(planEntry);
        // 設定計算覆蓋範圍，確保涵蓋滾動窗口
        const checkStart = new Date(planEntry);
        checkStart.setDate(checkStart.getDate() - 180); 
        
        let d = new Date(checkStart);
        while (d <= planExit) {
            const dateStr = d.toISOString().split('T')[0];
            // 預設在計劃出入境內的算申根，其餘先算非申根
            if (d >= planEntry && d <= planExit) {
                isSchengenMap[dateStr] = true;
            } else {
                isSchengenMap[dateStr] = false;
            }
            d.setDate(d.getDate() + 1);
        }

        // 2. 將使用者輸入的「非申根區」期間標註為 false (扣除掉)
        const nonSchStarts = document.querySelectorAll('.non-sch-start');
        const nonSchEnds = document.querySelectorAll('.non-sch-end');

        for (let i = 0; i < nonSchStarts.length; i++) {
            const sVal = nonSchStarts[i].value;
            const eVal = nonSchEnds[i].value;
            if (sVal && eVal) {
                let sDate = new Date(sVal);
                let eDate = new Date(eVal);
                
                // 注意：實務上離開申根當天與返回當天都算申根日（中轉算申根）
                // 為了嚴謹與安全計算，只有「完整在非申根國的整天」才扣除
                // 因此非申根的起始日+1，結束日-1，才是純非申根日
                let pureNonSchStart = new Date(sDate);
                pureNonSchStart.setDate(pureNonSchStart.getDate() + 1);
                let pureNonSchEnd = new Date(eDate);
                pureNonSchEnd.setDate(pureNonSchEnd.getDate() - 1);

                let curr = new Date(pureNonSchStart);
                while (curr <= pureNonSchEnd) {
                    const dateStr = curr.toISOString().split('T')[0];
                    if (dateStr in isSchengenMap) {
                        isSchengenMap[dateStr] = false;
                    }
                    curr.setDate(curr.getDate() + 1);
                }
            }
        }

        // 3. 檢查「預計離境日」當天往前推180天的申根總天數
        let totalSchengenDays = 0;
        let windowStart = new Date(planExit);
        windowStart.setDate(windowStart.getDate() - 179); // 包含當天共180天

        let checkDate = new Date(windowStart);
        while (checkDate <= planExit) {
            const dateStr = checkDate.toISOString().split('T')[0];
            if (isSchengenMap[dateStr] === true) {
                totalSchengenDays++;
            }
            checkDate.setDate(checkDate.getDate() + 1);
        }

        // 4. 計算何時可以「重新入境」（如果本次待滿或超額）
        // 原理：尋找在哪一天，往前倒推180天時，申根天數會小於90天
        let nextAvailableDate = "無需等待";
        if (totalSchengenDays >= 90) {
            let scanDate = new Date(planExit);
            scanDate.setDate(scanDate.getDate() + 1); // 從離開隔天開始找
            
            // 模擬未來的每一天，直到找到可重新入境的日子
            for (let attempt = 0; attempt < 365; attempt++) { 
                let count = 0;
                let refStart = new Date(scanDate);
                refStart.setDate(refStart.getDate() - 179);

                // 計算這一天往前180天內的申根天數
                let c = new Date(refStart);
                while (c <= scanDate) {
                    const dStr = c.toISOString().split('T')[0];
                    // 如果這天在歷史計畫中是申根日，就加1
                    if (isSchengenMap[dStr] === true) {
                        count++;
                    }
                    c.setDate(c.getDate() + 1);
                }

                if (count < 90) {
                    nextAvailableDate = scanDate.toISOString().split('T')[0];
                    break;
                }
                scanDate.setDate(scanDate.getDate() + 1);
            }
        }

        // 5. 渲染結果
        const resultDiv = document.getElementById('result');
        const resultTitle = document.getElementById('result-title');
        const resultDetails = document.getElementById('result-details');

        resultDiv.style.display = 'block';

        if (totalSchengenDays <= 90) {
            resultDiv.className = 'result-box result-success';
            resultTitle.innerHTML = '✅ 行程合法！未超出天數。';
            resultDetails.innerHTML = `
                <p><strong>本次滾動區間計算：</strong></p>
                <p>在您預計離開當天 (${exitInput}) 往前倒推的 180 天內：</p>
                <p>• 您的申根國總停留天數為：<strong style="font-size:18px;">${totalSchengenDays}</strong> 天 (尚有 ${90 - totalSchengenDays} 天額度)</p>
                <p>• 您隨時可以再次進入申根區，只要確保任意180天內不超標即可。</p>
            `;
        } else {
            resultDiv.className = 'result-box result-danger';
            resultTitle.innerHTML = '❌ 警報！您已違反 90/180 天規定。';
            resultDetails.innerHTML = `
                <p><strong>超期違規計算：</strong></p>
                <p>在您預計離開當天 (${exitInput}) 往前倒推的 180 天內：</p>
                <p>• 您的申根國總停留天數高達：<strong style="font-size:18px;">${totalSchengenDays}</strong> 天 (超出法定額度 ${totalSchengenDays - 90} 天！)</p>
                <p style="color:var(--danger); font-weight:bold;">⚠️ 您必須縮短行程或增加在非申根國停留的時間。</p>
                <hr style="border: 0; border-top: 1px solid #f5c6cb;">
                <p><strong>💡 重新入境預測：</strong></p>
                <p>假設您依照此行程強制在歐盟待到 ${exitInput}，您下一次<strong>可以合法「重新入境」</strong>申根區的日期為：</p>
                <p><strong style="font-size:20px; color:#c00;">${nextAvailableDate}</strong></p>
            `;
        }
    }
</script>

</body>
</html>
